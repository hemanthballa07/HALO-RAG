# Environment variables for HALO-RAG Service
# Copy this file to .env and customize as needed

# Service Configuration
HALO_RAG_DEBUG=false
HALO_RAG_HOST=0.0.0.0
HALO_RAG_PORT=8000

# Device Configuration
HALO_RAG_DEVICE=cuda  # or cpu

# Model Configuration (optional - uses defaults from config.yaml if not set)
# HALO_RAG_DENSE_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
# HALO_RAG_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# HALO_RAG_GENERATOR_MODEL_NAME=google/flan-t5-large
# HALO_RAG_ENTAILMENT_MODEL_NAME=cross-encoder/nli-deberta-v3-base
# HALO_RAG_GENERATOR_LORA_CHECKPOINT=/path/to/lora/checkpoint

# Corpus Configuration
# HALO_RAG_CORPUS_PATH=/path/to/corpus.txt

# Retrieval Configuration
HALO_RAG_TOP_K_RETRIEVE=20
HALO_RAG_TOP_K_RERANK=5

# Generation Configuration
HALO_RAG_MAX_NEW_TOKENS=256
HALO_RAG_TEMPERATURE=0.7
HALO_RAG_DO_SAMPLE=true

# Verification Configuration
HALO_RAG_ENTAILMENT_THRESHOLD=0.75
HALO_RAG_ENABLE_VERIFICATION=true
HALO_RAG_ENABLE_REVISION=true
HALO_RAG_MAX_REVISION_ITERATIONS=3

# Logging Configuration
HALO_RAG_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
HALO_RAG_LOG_FORMAT=json  # json or text

# YAML Config (optional - overrides above settings)
# HALO_RAG_CONFIG_YAML_PATH=../config/config.yaml
